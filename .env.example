# 拼好码 CLI 工具配置
# CodePinHub CLI Configuration

# API 服务器地址
PNCE_API_SERVER=http://localhost:3000

# OAuth2 授权端点
PNCE_OAUTH_ENDPOINT=http://localhost:5173/authorize

# OAuth2 回调端口
PNCE_OAUTH_PORT=3001

# 用户认证令牌（通过 login 命令自动设置，不需要手动配置）
PNCE_TOKEN=

# 输出目录
PNCE_OUTPUT_DIR=

# 代理设置
PNCE_PROXY_URL=

# 日志级别 (error, warn, info, debug)
PNCE_LOG_LEVEL=info

# 详细输出
PNCE_VERBOSE=false

# 禁用缓存
PNCE_NO_CACHE=false
