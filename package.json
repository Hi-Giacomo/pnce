{
  "name": "pnce",
  "version": "0.0.9",
  "description": "Pnce CLI Tool - 模块化快速开发命令行工具",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "pnce": "./dist/index.js"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/templates/**/*.ts",
    "dist/templates/**/*.md",
    "dist/templates/**/*.json",
    "dist/templates/docs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": [
      "dist/templates/**/*",
      "dist/locales/**/*"
    ],
    "targets": [
      "node18-macos-x64",
      "node18-linux-x64",
      "node18-win-x64"
    ],
    "outputPath": "./release"
  },
  "author": "Hi-Giacomo",
  "license": "MulanPSL2",
  "repository": {
    "type": "git",
    "url": "https://github.com/hi-giacomo/pnce"
  },
  "bugs": {
    "url": "https://github.com/hi-giacomo/pnce/issues"
  },
  "homepage": "https://github.com/hi-giacomo/pnce",
  "scripts": {
    "build": "tsc && node scripts/copy-templates.js && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "pkg:build": "npm run build && pkg . --output ./release/pnce",
    "pkg:build:mac": "npm run build && pkg . --targets node18-macos-x64 --output ./release/pnce-macos",
    "pkg:build:linux": "npm run build && pkg . --targets node18-linux-x64 --output ./release/pnce-linux",
    "pkg:build:win": "npm run build && pkg . --targets node18-win-x64 --output ./release/pnce-win.exe"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "axios": "^1.6.7",
    "axios-retry": "^4.5.0",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "commander": "^11.1.0",
    "crypto-js": "^4.2.0",
    "form-data": "^4.0.0",
    "fs-extra": "^11.2.0",
    "tar": "^6.2.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cli-progress": "^3.11.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.0",
    "@types/tar": "^6.1.13",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "keytar": "^7.9.0",
    "lint-staged": "^16.3.2",
    "pkg": "^5.8.1",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
