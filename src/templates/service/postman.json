{
  "info": {
    "name": "Service API",
    "description": "Service Microservice API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Hello",
      "item": [
        {
          "name": "Hello World",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hello/world",
              "host": ["{{baseUrl}}"],
              "path": ["hello", "world"]
            },
            "description": "Get Hello World message"
          }
        }
      ]
    },
    {
      "name": "Environment Variable Management",
      "item": [
        {
          "name": "Get All Environment Variables",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/env",
              "host": ["{{baseUrl}}"],
              "path": ["env"]
            },
            "description": "Get values of all current environment variables"
          }
        },
        {
          "name": "Get Single Environment Variable",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/env/PORT",
              "host": ["{{baseUrl}}"],
              "path": ["env", "PORT"]
            },
            "description": "Get the value of a specified environment variable, replace PORT with actual variable name"
          }
        },
        {
          "name": "Get Configuration Object",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/env/config/all",
              "host": ["{{baseUrl}}"],
              "path": ["env", "config", "all"]
            },
            "description": "Get structured configuration object"
          }
        },
        {
          "name": "Set Environment Variable",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"PORT\",\n  \"value\": \"4000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/env",
              "host": ["{{baseUrl}}"],
              "path": ["env"]
            },
            "description": "Set a single environment variable. Modifying PORT or NODE_ENV will automatically restart the service."
          }
        },
        {
          "name": "Batch Set Environment Variables",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"envVars\": {\n    \"DB_HOST\": \"192.168.1.100\",\n    \"DB_PORT\": \"5432\",\n    \"DB_NAME\": \"production_db\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/env/batch",
              "host": ["{{baseUrl}}"],
              "path": ["env", "batch"]
            },
            "description": "Set multiple environment variables in batch, including PORT or NODE_ENV will trigger restart"
          }
        },
        {
          "name": "Delete Environment Variable",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/env/REDIS_PASSWORD",
              "host": ["{{baseUrl}}"],
              "path": ["env", "REDIS_PASSWORD"]
            },
            "description": "Delete specified environment variable, replace REDIS_PASSWORD with actual variable name"
          }
        },
        {
          "name": "Reload Environment Variables",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/env/reload",
              "host": ["{{baseUrl}}"],
              "path": ["env", "reload"]
            },
            "description": "Reload all environment variables from .env file to process.env"
          }
        }
      ]
    }
  ]
}
