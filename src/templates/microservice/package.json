{
  "name": "microservice",
  "version": "0.0.1",
  "description": "Microservice module",
  "main": "dist/index.js",
  "workspaces": [
    "src/local_modules/*",
    "src/external_modules/*"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "start": "nest start"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "dotenv": "^16.4.5",
    "chokidar": "^4.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^25.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "author": "module-author",
  "license": "MIT",
  "keywords": [
    "nest",
    "microservice",
    "module"
  ],
  "localModules": {
    "{{moduleName}}": "{{version}}-local"
  }
}